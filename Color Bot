# Additional utility functions for the bot
class ColorMixingUtils:
    """Utility functions for color mixing calculations"""
    
    @staticmethod
    def hex_to_rgb(hex_color: str) -> tuple:
        """Convert hex color to RGB"""
        hex_color = hex_color.lstrip('#')
        return tuple(int(hex_color[i:i+2], 16) for i in (0, 2, 4))
    
    @staticmethod
    def rgb_to_hex(rgb: tuple) -> str:
        """Convert RGB to hex color"""
        return f"#{rgb[0]:02x}{rgb[1]:02x}{rgb[2]:02x}"
    
    @staticmethod
    def calculate_professional_mix(color1: Dict, color2: Dict) -> Dict:
        """Professional color mixing calculations"""
        
        # Level mixing (hair color science)
        level1, level2 = color1['level'], color2['level']
        
        if abs(level1 - level2) <= 1:
            # Same level mixing
            result_level = (level1 + level2) / 2
            mixing_ratio = "1:1"
            developer_vol = 30 if result_level >= 7 else 20
        elif level1 > level2:
            # Lightening mix
            result_level = level1 - 0.5
            mixing_ratio = "2:1 (más del color claro)"
            developer_vol = 30
        else:
            # Darkening mix
            result_level = level2 - 0.5
            mixing_ratio = "1:2 (más del color oscuro)"
            developer_vol = 20
        
        # Processing time based on target level
        if result_level >= 8:
            processing_time = "35-40 minutos"
        elif result_level >= 6:
            processing_time = "30-35 minutos"
        else:
            processing_time = "25-30 minutos"
        
        # Professional recommendations
        recommendations = []
        
        if result_level >= 8:
            recommendations.append("Requiere decoloración previa")
        if 'ash' in color1['name'].lower() or 'ash' in color2['name'].lower():
            recommendations.append("Neutralizará tonos amarillos")
        if 'copper' in color1['name'].lower() or 'copper' in color2['name'].lower():
            recommendations.append("Resultado con reflejos cobrizos intensos")
        
        return {
            'result_level': round(result_level, 1),
            'mixing_ratio': mixing_ratio,
            'developer_volume': developer_vol,
            'processing_time': processing_time,
            'recommendations': recommendations,
            'color_family': ColorMixingUtils.determine_color_family(color1, color2)
        }
    
    @staticmethod
    def determine_color_family(color1: Dict, color2: Dict) -> str:
        """Determine the resulting color family"""
        names = (color1['name'] + ' ' + color2['name']).lower()
        
        if 'copper' in names or 'red' in names:
            return "Cobrizo/Rojizo"
        elif 'ash' in names or 'grey' in names:
            return "Ceniza"
        elif 'gold' in names or 'honey' in names:
            return "Dorado"
        elif 'blonde' in names:
            return "Rubio"
        elif 'brown' in names:
            return "Castaño"
        else:
            return "Mixto"

